# FOMO Client
FOMO_API_KEY=your_fomo_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# MiroFish Backend
DATABASE_URL=postgresql://trading:trading_secret@postgres:5432/trading_db
REDIS_URL=redis://redis:6379
MIROFISH_SECRET=your_mirofish_secret_here

# Kronos
KRONOS_API_KEY=your_kronos_api_key_here
STRATEGY_CONFIG={"risk_level":"medium","max_position":"0.1"}

# Agent Arena
OLLAMA_HOST=http://host.docker.internal:11434
ARENA_SECRET=your_arena_secret_here

# Robinhood Executor
ROBINHOOD_API_KEY=your_robinhood_api_key_here
ROBINHOOD_SECRET=your_robinhood_secret_here
ROBINHOOD_CHAIN_ID=1
PRIVATE_KEY=your_robinhood_private_key_here

# PostgreSQL
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_secret
POSTGRES_DB=trading_db
